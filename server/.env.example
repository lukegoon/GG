# Server environment variables
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql://recruitiq:recruitiq_dev@db:5432/recruitiq

# JWT
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development

# Convoso API
CONVOSO_BASE_URL=https://api.convoso.com
CONVOSO_API_KEY=your_convoso_api_key_here

# Google Sheets Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_google_sheet_id_here

# Sheet tab names (customize to match your actual tab names)
SHEET_HIRES_TAB=Hires
SHEET_GOALS_TAB=Goals
SHEET_NOTES_TAB=Notes
SHEET_OVERRIDES_TAB=Overrides

# Cron schedule (default: every 15 min, 7am-8pm weekdays)
CRON_SCHEDULE=*/15 7-20 * * 1-5
